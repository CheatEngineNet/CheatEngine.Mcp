<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- The HTTP adapter deliberately opts into the Client's experimental typed APIs. -->
    <NoWarn>$(NoWarn);CECLIENT5001;CECLIENT5002;CECLIENT5003;CECLIENT5004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Build the exact submodule revision, rather than substituting a Client NuGet release. -->
    <ProjectReference Include="../../CheatEngine.Client/src/CheatEngine.Client/CheatEngine.Client.csproj" />
    <!-- Direct SDK build assets generate the entry point and copy the native Lua bridge. -->
    <PackageReference Include="CheatEngine.SDK" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../README.md;../../LICENSE" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../CheatEngine.Client/LICENSE" Link="licenses/CheatEngine.Client.LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../skills/cheatengine-mcp/**/*.*"
             Exclude="../../skills/cheatengine-mcp/references/local-cheat-engine.md;../../skills/cheatengine-mcp/references/.gitignore">
      <Link>skills/cheatengine-mcp/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
