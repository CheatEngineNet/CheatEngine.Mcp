<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Keep the implicit SDK tool dependency identical for build and single-file publish restores. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../CheatEngine.Mcp/CheatEngine.Mcp.csproj" />
  </ItemGroup>
  <!-- These transitive plugin assets belong inside the plugin bundle, not beside the gateway. -->
  <Target Name="McpExcludePluginContentFromGateway" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.CopyToPublishDirectory)' != ''" />
    </ItemGroup>
  </Target>
</Project>
