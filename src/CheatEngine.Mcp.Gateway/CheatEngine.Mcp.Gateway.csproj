<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../CheatEngine.Mcp/CheatEngine.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProjectReference supplies the assemblies/native bridge; CE also needs the plugin's own host manifests. -->
    <None Include="$(ArtifactsPath)/bin/CheatEngine.Mcp/$(Configuration.ToLowerInvariant())/CheatEngine.Mcp.deps.json;$(ArtifactsPath)/bin/CheatEngine.Mcp/$(Configuration.ToLowerInvariant())/CheatEngine.Mcp.runtimeconfig.json"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
