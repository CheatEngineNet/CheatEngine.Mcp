<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cheat Engine MCP resources. The only public composition entry point is ICheatEngineMcpBuilder.AddResources().
    Resources are declared with AddResourceType<T>() and must be routed by the gateway before they are composed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../libs/CheatEngine.Mcp.Core/CheatEngine.Mcp.Core.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <Using Include="CheatEngine.Mcp.Core.Composition"/>
  </ItemGroup>
</Project>
