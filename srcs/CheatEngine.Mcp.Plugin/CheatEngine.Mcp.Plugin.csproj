<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CheatEngine.Mcp</AssemblyName>
    <FodyGenerateXsd>false</FodyGenerateXsd>
    <!--
      The Cheat Engine plugin: the Client plugin profile (CECLIENT001-017, and CECLIENT010-016 for a staged deployment
      through CheatEnginePluginOutputPath) plus the repository guards, for which McpPluginProject marks this project.
    -->
    <CheatEngineClientPluginProject>true</CheatEngineClientPluginProject>
    <McpPluginProject>true</McpPluginProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!--
      Measured: the ASP.NET Core 10 shared-framework assemblies carry no IsAotCompatible/IsTrimmable metadata, so the
      reference checks report IL3058/IL2125 for them alone. This project's own code stays analyzed (CEMCP005); the
      plugin itself is never published as Native AOT (CEMCP006).
    -->
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <VerifyReferenceTrimCompatibility>false</VerifyReferenceTrimCompatibility>
    <!-- The HTTP adapter deliberately opts into the Client's experimental typed APIs. -->
    <NoWarn>$(NoWarn);CECLIENT5001;CECLIENT5002;CECLIENT5003;CECLIENT5004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="CheatEngine.Client"/>
    <!-- Direct SDK build assets generate the entry point and copy the native Lua bridge. -->
    <PackageReference Include="CheatEngine.SDK"/>
    <PackageReference Include="Costura.Fody" PrivateAssets="all"/>
    <PackageReference Include="Fody" PrivateAssets="all"/>
    <PackageReference Include="ModelContextProtocol.AspNetCore"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../libs/CheatEngine.Mcp.Core/CheatEngine.Mcp.Core.csproj"/>
    <ProjectReference Include="../CheatEngine.Mcp.Hosting/CheatEngine.Mcp.Hosting.csproj"/>
    <ProjectReference Include="../CheatEngine.Mcp.Prompts/CheatEngine.Mcp.Prompts.csproj"/>
    <ProjectReference Include="../CheatEngine.Mcp.Resources/CheatEngine.Mcp.Resources.csproj"/>
    <ProjectReference Include="../CheatEngine.Mcp.Tools/CheatEngine.Mcp.Tools.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <Using Include="CheatEngine.Mcp.Core.Composition"/>
    <Using Include="CheatEngine.Mcp.Core.Lua"/>
    <Using Include="CheatEngine.Mcp.Core.Runtime"/>
    <InternalsVisibleTo Include="CheatEngine.Mcp.Tests"/>
  </ItemGroup>
  <ItemGroup>
    <!-- Costura extracts and preloads the SDK's native bridge with its embedded managed dependencies. -->
    <Content Update="$(_CheatEngineSdkLuaBridgePath)" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never"/>
    <CustomAdditionalCompileInputs Include="$(_CheatEngineSdkLuaBridgePath)"/>
  </ItemGroup>
  <!-- Reference assemblies can stay unchanged when dependency code or embedded docs change. Costura must receive a
       fresh plugin assembly when any copy-local implementation changes; Fody runs only after compilation. -->
  <Target Name="McpTrackBundledDependencies" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(ReferenceCopyLocalPaths)"/>
    </ItemGroup>
  </Target>
  <!-- SDK exposes the bridge as Content; Costura needs a copy-local input to generate its checksum and preload list. -->
  <Target Name="McpIncludeNativeBridgeForCostura" BeforeTargets="FodyTarget"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="$(_CheatEngineSdkLuaBridgePath)"/>
    </ItemGroup>
  </Target>
</Project>
