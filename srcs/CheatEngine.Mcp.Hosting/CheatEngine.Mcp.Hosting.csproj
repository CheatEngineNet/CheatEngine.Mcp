<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MCP hosting: the per-activation authenticated loopback backend, its options, the file-based instance discovery
    contract and the stdio multi-instance gateway. It sees primitives only through the Core manifest; it never references
    Tools, Resources or Prompts, the Cheat Engine SDK, NLog or Cheat Engine UI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    <ProjectReference Include="../../libs/CheatEngine.Mcp.Core/CheatEngine.Mcp.Core.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <Using Include="CheatEngine.Mcp.Core.Composition"/>
    <Using Include="CheatEngine.Mcp.Core.Runtime"/>
    <InternalsVisibleTo Include="CheatEngine.Mcp.Tests"/>
  </ItemGroup>
</Project>
