<Project>
    <PropertyGroup>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <!-- Native AOT is self-contained, trimmed and a single native executable. -->
        <PublishAot>true</PublishAot>
        <!-- Keep the solution's portable lock independent from Native AOT's implicit ILCompiler package. -->
        <NuGetLockFilePath>packages.aot.lock.json</NuGetLockFilePath>
        <StripSymbols>true</StripSymbols>
        <PublishDir>$(ArtifactsPath)/publish/CheatEngine.Mcp.Gateway/$(Configuration.ToLowerInvariant())-nativeaot/</PublishDir>
    </PropertyGroup>
</Project>
