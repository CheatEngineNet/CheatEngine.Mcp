<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cheat Engine MCP prompts. The only public composition entry point is ICheatEngineMcpBuilder.AddPrompts().
    Prompts are declared with AddPromptType<T>() and must be routed by the gateway before they are composed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../libs/CheatEngine.Mcp.Core/CheatEngine.Mcp.Core.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <Using Include="CheatEngine.Mcp.Core.Composition"/>
  </ItemGroup>
</Project>
